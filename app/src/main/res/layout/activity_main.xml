<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#1E1E1E">

    <TextView
        android:id="@+id/tvFrameResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00초 (총 0프레임)"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="00:00.00"
        android:textColor="#AAAAAA"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv1Comma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="1콤마 (24fps): 0 프레임"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv2Comma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="2콤마 (12fps): 0 프레임"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tv3Comma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="3콤마 (8fps): 0 프레임"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="시작"
            android:textSize="15sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="일시정지"
            android:textSize="15sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:text="초기화"
            android:textSize="15sp"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />
    </LinearLayout>

    <com.example.aniframeapp.TimelineView
        android:id="@+id/timelineView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="32dp" />

    <SeekBar
        android:id="@+id/seekBarZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="50" />

</LinearLayout>