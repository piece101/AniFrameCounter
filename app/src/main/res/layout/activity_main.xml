<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#1E1E1E">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:background="#888888">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:text="@string/credit_text"
                android:textColor="#CCFFFFFF"
                android:textSize="26sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/menuToolbar"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#333333"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_menu_open">

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="5dp"
                    android:background="#AAAAAA" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="5dp"
                    android:background="#AAAAAA" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:background="#AAAAAA" />

            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_placeholder"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▲"
                                android:textColor="#888888"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="▼"
                                android:textColor="#888888"
                                android:textSize="14sp" />

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/commaWheel"
                            android:layout_width="180dp"
                            android:layout_height="32dp"
                            android:clipToPadding="false"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▲"
                                android:textColor="#888888"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="▼"
                                android:textColor="#888888"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvCommaLockMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="46dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/comma_lock_message"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:background="#AA888888"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectedFrames"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/drawing_no_placeholder"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="0dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:text="@string/btn_play"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:backgroundTint="#FFFFFF"
                    app:rippleColor="#888888" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="@string/btn_reset"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    app:rippleColor="#888888" />
            </LinearLayout>

            <com.example.aniframeapp.TimelineView
                android:id="@+id/timelineView"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="36dp"
                android:contentDescription="@string/cd_timeline" />

            <SeekBar
                android:id="@+id/seekBarZoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:max="100"
                android:progress="50" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRecordTiming"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_record_timing"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:backgroundTint="#FFFF00"
                    app:rippleColor="#AAAA00" />

                <Button
                    android:id="@+id/btnClearTiming"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:layout_weight="1"
                    android:text="@string/btn_clear_timing"
                    android:textSize="14sp"
                    android:textColor="#000000"
                    android:backgroundTint="#FFFFFF"
                    app:rippleColor="#888888" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="63dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:background="#000000">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/topSlot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="21dp"
                    android:paddingBottom="21dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bottomSlot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="21dp"
                    android:paddingBottom="21dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvFramesNeeded"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="4dp"
                    android:text="@string/frames_needed_placeholder"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnSaveTiming"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:text="@string/btn_save_timing"
                android:textSize="14sp"
                android:textColor="#000000"
                android:backgroundTint="#FFFF00"
                app:rippleColor="#AAAA00" />

        </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#77000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/slideDrawer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="#888888">

        <LinearLayout
            android:id="@+id/drawerHeader"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#888888">

            <LinearLayout
                android:id="@+id/drawerToggleIcon"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#333333"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_menu_toggle">

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="5dp"
                    android:background="#AAAAAA" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="5dp"
                    android:background="#AAAAAA" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="2dp"
                    android:background="#AAAAAA" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/drawerBackButton"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#333333"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_back_curved"
                    android:contentDescription="@string/cd_back" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectionToolbar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#888888"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/selectionBackButton"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="#333333"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_back_curved"
                    android:contentDescription="@string/cd_exit_selection" />

            </LinearLayout>

            <CheckBox
                android:id="@+id/cbSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/btn_select_all"
                android:textColor="#FFFFFF" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnExportSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:padding="8dp"
                android:text="@string/btn_export"
                android:textColor="#FFFF00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/drawerMenuList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemSavedTimings"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/menu_saved_timings"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="#666666" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#AAAAAA" />

            <TextView
                android:id="@+id/itemExportTiming"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/menu_export_timing"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="#666666" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#AAAAAA" />

            <TextView
                android:id="@+id/itemImportTiming"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/menu_import_timing"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:background="#666666" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/savedTimingsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/savedTimingsList"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                android:padding="16dp"
                android:text="@string/no_saved_files"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#2E4A8A"
                android:visibility="gone" />

            <View
                android:id="@+id/scrollThumb"
                android:layout_width="6dp"
                android:layout_height="40dp"
                android:layout_gravity="end|top"
                android:layout_marginEnd="4dp"
                android:background="#CCCCCC"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>